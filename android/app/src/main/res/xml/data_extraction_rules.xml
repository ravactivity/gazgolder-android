<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="data/" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="data/.deleted/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="data/" />
        <include domain="file" path="media/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
